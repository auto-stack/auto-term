// app src/back/api.at — #[api] 契约面(PLAN-013 T5;017 at-app→app 置换)
//
// 全标量/[]str 面:rust merged(db 吸收委托)、vue split(a2r axum
// handlers 调 db.rs)、VM/desktop merged(api fn 字节码直调 db)同源。
// 实现体在 db.at(api.at 仅为契约 + VM 直跑的委托体)。
// PLAN-018 D7:/api/mux/* 结构操作契约面(为 Phase 4 Control API 铺
// 地基但**不是** Control API——无 socket/CLI/权限分级)。端点名与
// db.at 实现同名(merged_db_delegate 同名吸收惯例)。

use db

/// 每拍驱动(几何存 db 侧全局,首调 spawn)。
#[api(method = "POST", path = "/api/term/tick")]
pub fn get_lines() []str {
    return db.get_lines()
}

/// 宿主 → 子进程一行输入。
#[api(method = "POST", path = "/api/term/send")]
pub fn term_send(line str) {
    db.term_send(line)
}

/// Ctrl+C 中断。
#[api(method = "POST", path = "/api/term/interrupt")]
pub fn term_interrupt() int {
    return db.term_interrupt()
}

/// 直键入泵:terminal 组件键盘队列 → 引擎裸写(014;载荷不经 HTTP,
/// vue 形态此路由恒 0——队列在窗口进程)。
#[api(method = "POST", path = "/api/term/pump")]
pub fn term_pump_input() int {
    return db.term_pump_input()
}

/// 几何随动:应用 widget 的待定 resize(引擎 resize + 几何同步);
/// 1=已应用 0=无请求。
#[api(method = "POST", path = "/api/term/apply-resize")]
pub fn term_apply_resize() int {
    return db.term_apply_resize()
}

/// 当前视口几何(apply_resize/ spawn 后同步)。
#[api(method = "GET", path = "/api/term/cols")]
pub fn term_cols() int {
    return db.term_cols()
}

#[api(method = "GET", path = "/api/term/rows")]
pub fn term_rows() int {
    return db.term_rows()
}

/// 光标格(引擎 feed 采样;未采样为 0)。
#[api(method = "GET", path = "/api/term/cursor-row")]
pub fn term_cursor_row() int {
    return db.term_cursor_row()
}

#[api(method = "GET", path = "/api/term/cursor-col")]
pub fn term_cursor_col() int {
    return db.term_cursor_col()
}

/// 014 积压采样(tick 驱动;返回本次新报警次数,>0 = 刚发生一次越线)。
#[api(method = "POST", path = "/api/term/backlog-sample")]
pub fn term_backlog_sample() int {
    return db.term_backlog_sample()
}

/// 014 累计报警次数(进程生命周期内)。
#[api(method = "GET", path = "/api/term/backlog-alerts-total")]
pub fn term_backlog_alerts_total() int {
    return db.term_backlog_alerts_total()
}

/// 014 当前积压 MB(告警线 2MB;反压上限 8MB)。
#[api(method = "GET", path = "/api/term/backlog-pending-mb")]
pub fn term_backlog_pending_mb() int {
    return db.term_backlog_pending_mb()
}

/// 014 reader 反压暂停中(1 = 积压超上限已暂停读取,0 = 正常)。
#[api(method = "GET", path = "/api/term/backlog-paused")]
pub fn term_backlog_paused() int {
    return db.term_backlog_paused()
}

/// 014 累计丢帧块数(环形缓冲逐出;0 = 未丢)。
#[api(method = "GET", path = "/api/term/backlog-dropped")]
pub fn term_backlog_dropped() int {
    return db.term_backlog_dropped()
}

/// 子进程退出态。
#[api(method = "GET", path = "/api/term/exited")]
pub fn term_exited() bool {
    return db.term_exited()
}

// ── PLAN-018 D7:MuxCore 结构操作(/api/mux/*;Action 单入口的契约面)──

/// 分屏:活动焦点 Pane 叶位替换为分支(axis 0=纵向 1=横向)。
/// 返回新 Pane id(0 = 失败)。
#[api(method = "POST", path = "/api/mux/split")]
pub fn mux_split(axis int) int {
    return db.mux_split(axis)
}

/// 关 Pane(兄弟收编父位)。1=已关 0=末 Pane 拒绝 -1=未找到。
#[api(method = "POST", path = "/api/mux/close-pane")]
pub fn mux_close_pane(pane_id int) int {
    return db.mux_close_pane(pane_id)
}

/// 焦点切换。1=成功 -1=未找到。
#[api(method = "POST", path = "/api/mux/focus")]
pub fn mux_focus(pane_id int) int {
    return db.mux_focus(pane_id)
}

/// 缩放开关。1=缩放中 0=取消 -1=未找到。
#[api(method = "POST", path = "/api/mux/zoom")]
pub fn mux_zoom(pane_id int) int {
    return db.mux_zoom(pane_id)
}

/// 新 Tab(自动激活)。返回 tab id。
#[api(method = "POST", path = "/api/mux/new-tab")]
pub fn mux_new_tab() int {
    return db.mux_new_tab()
}

/// 关 Tab。1=已关 0=末 Tab 拒绝 -1=未找到。
#[api(method = "POST", path = "/api/mux/close-tab")]
pub fn mux_close_tab(tab_id int) int {
    return db.mux_close_tab(tab_id)
}

/// 激活 Tab。1=成功 -1=未找到。
#[api(method = "POST", path = "/api/mux/activate-tab")]
pub fn mux_activate_tab(tab_id int) int {
    return db.mux_activate_tab(tab_id)
}

/// 结构快照(JSON 串;结构断言/观测面)。
#[api(method = "GET", path = "/api/mux/snapshot")]
pub fn mux_snapshot() str {
    return db.mux_snapshot()
}

/// 焦点 Pane 视口宽(db 同步值)。
#[api(method = "GET", path = "/api/mux/cols")]
pub fn mux_cols() int {
    return db.mux_cols()
}

/// 焦点 Pane 视口高(db 同步值)。
#[api(method = "GET", path = "/api/mux/rows")]
pub fn mux_rows() int {
    return db.mux_rows()
}

/// 焦点 Pane 模型 key(pane-<id>;"" = 无)。
#[api(method = "GET", path = "/api/mux/focus-key")]
pub fn mux_focus_key() str {
    return db.mux_focus_key()
}
