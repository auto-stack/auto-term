// autoterm_store.at — PLAN-013 T7:AutoTerm 会话 store(自 auto-os-config
// OS-013 T3 升格移植,独立 app 唯一演化点;os-config 内嵌页保留原位)。
//
// 引擎面 = auto-lang auto.term.* catalog shim(OS-013 T2,进程内
// autoterm_core.dll,003 §5 契约):Term.engine_* 接收者式调用,无需 use
// 导入(catalog 固定 ID,codegen 任意时刻可解析)。会话按需开关
//(Open=spawn / Close=free);.Tick 由 App 根 widget 200ms 节拍转发,
// 收割引擎输出快照——loop+push 重建纯模型数组(VG5 惯例,规避 native
// list 直入 state 的 RC 面)。
store AutoTerm {
    model {
        var term_handle int = 0
        var term_cols int = 80
        var term_rows int = 24
        var term_lines Array<str> = []
        var term_input str = ""
        var term_exited bool = false
        var term_status str = "idle"
    }

    msg Msg { Open, Close, Send, Interrupt, ResizeToggle, InputChanged(str), Tick }

    on {
        .Open -> {
            if .term_handle == 0 {
                var h = Term.engine_spawn(.term_cols, .term_rows)
                if h > 0 {
                    .term_handle = h
                    .term_status = "running"
                    .term_exited = false
                    .term_lines = []
                }
            }
        }
        .Close -> {
            if .term_handle > 0 {
                Term.engine_free(.term_handle)
            }
            .term_handle = 0
            .term_status = "idle"
            .term_lines = []
        }
        .Send -> {
            if .term_handle > 0 {
                if .term_input != "" {
                    Term.engine_write_line(.term_handle, .term_input)
                    .term_input = ""
                }
            }
        }
        .Interrupt -> {
            if .term_handle > 0 {
                Term.engine_interrupt(.term_handle)
            }
        }
        .ResizeToggle -> {
            if .term_cols == 80 {
                .term_cols = 100
                .term_rows = 30
            } else {
                .term_cols = 80
                .term_rows = 24
            }
            if .term_handle > 0 {
                Term.engine_resize(.term_handle, .term_cols, .term_rows)
            }
        }
        .InputChanged(v) -> {
            .term_input = v
        }
        .Tick -> {
            if .term_handle > 0 {
                var snap = Term.engine_rows(.term_handle)
                var n = snap.len()
                var out = []
                var i = 0
                loop {
                    if i >= n {
                        break
                    }
                    var line = snap.get(i)
                    out.push(line)
                    i = i + 1
                }
                .term_lines = out
                .term_exited = Term.engine_is_exited(.term_handle)
                if .term_exited {
                    .term_status = "exited"
                }
            }
        }
    }
}
