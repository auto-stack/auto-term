// autoterm_page.at — PLAN-013 T7:AutoTerm 终端会话页(自 auto-os-config
// OS-013 T3 升格移植;去 desktop_page 注册表分发层,独立 app 根直挂)。
//
// view = <terminal/>(auto-lang View::Terminal,PLAN-009 P1 真身;props:
// term_cols/term_rows/term_lines 经 store 投影)+ 会话控制条 + 输入行(echo 往返面)。
// vm 布局循 desktop_page 约定:无 min-h-0,间距整数档,中性色确定性 hex。
use autoterm_store: AutoTerm

widget AutoTermPage {
    msg Msg { Open, Close, Send, Interrupt, ResizeToggle, InputChanged(str) }

    view {
        col (style: "flex-1 flex flex-col gap-2") {
            row (style: "flex flex-row items-center gap-2") {
                text (text: "AutoTerm", style: "text-base font-semibold text-[#1a1a1a]") {}
                text (text: .store.term_status, style: "text-xs text-[#8a8a8a]") {}
                if .store.term_exited {
                    text (text: "session exited", style: "text-xs text-[#c42b1c]") {}
                }
                div (style: "flex-1") {}
                button (text: "New Session", style: "px-3 py-[6px] rounded text-xs border border-[#e0e0e0] bg-white") {
                    onclick: .Open
                }
                button (text: "Interrupt", style: "px-3 py-[6px] rounded text-xs border border-[#e0e0e0] bg-white") {
                    onclick: .Interrupt
                }
                button (text: "Resize", style: "px-3 py-[6px] rounded text-xs border border-[#e0e0e0] bg-white") {
                    onclick: .ResizeToggle
                }
                button (text: "Close", style: "px-3 py-[6px] rounded text-xs bg-[#c42b1c] border border-[#c42b1c] text-white") {
                    onclick: .Close
                }
            }
            row (style: "flex flex-row gap-2") {
                input (value: .store.term_input, placeholder: "Type a command and press Send…", style: "flex-1 px-[10px] py-[6px] text-sm bg-white border border-[#e0e0e0] rounded") {
                    oninput: .InputChanged
                }
                button (text: "Send", style: "px-5 py-2 rounded text-sm bg-primary border-primary text-white") {
                    onclick: .Send
                }
            }
            if .store.term_handle > 0 {
                terminal (key: "autoterm", cols: .store.term_cols, rows: .store.term_rows, lines: .store.term_lines) {}
            }
            if .store.term_handle == 0 {
                col (style: "flex-1 flex flex-col items-center justify-center gap-[0px]") {
                    text (text: "No session — click New Session to spawn a terminal", style: "text-base text-[#8a8a8a]") {}
                }
            }
        }
    }

    on {
        .Open -> { AutoTerm.Open() }
        .Close -> { AutoTerm.Close() }
        .Send -> { AutoTerm.Send() }
        .Interrupt -> { AutoTerm.Interrupt() }
        .ResizeToggle -> { AutoTerm.ResizeToggle() }
        .InputChanged(v) -> { AutoTerm.InputChanged(v) }
    }
}
