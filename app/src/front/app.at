// app src/front/app.at — AutoTerm 标准 AutoUI 前端(PLAN-013 T5;
// 014 直键入收口;017 at-app→app 置换;PLAN-019 可见多终端 UI;
// PLAN-020 rev2 矩形投影 N 槽视图)
//
// PLAN-020(T-02,§9 rev2 勘定):布局消费从槽位 if 枚举升级为**矩形
// 投影静态 N 槽**——back 对活动 Tab 可见子树 BFS 出 pane 槽(1..6,
// ‰)与 divider 槽(7..11);本视图每槽一个 absolute 浮层(px 类几何,
// 模型持内容区 px = 窗口 client − Tab 条高),terminal 按槽动态键绑定
// (014 可用空间反推在 px 容器内闭合);分隔条 = mouse-area 薄条
// (onmousedown 记分支)+ 拖拽中全幅捕获层(coords "1000x1000" 归一
// ‰,onmousemove 直喂 back mux_resize_branch,onmouseup 落定)——
// 磁吸/钳位在 back 单一真相源。捷径表仍单槽挂载(slot1;019 窗口
// 全局语义去重惯例)。handler 全内联(019 惯例,widget 内 fn 无 UI 先例)。
//
// PLAN-026 T-03:Tick/Init/KeyIn 数据面改 tick-snapshot 聚合消费
//(每拍 HTTP 22-68 次 → 3 次;split 形态 VM api.* = 主线程同步忙等,
// 批量化 = 挂起根修)。快照 = []str 混合记录(结构管道分隔 + 行原样
// 跟段;T-01 rev3:JSON str 形态被 a2r 前端转译否决,json.parse/点访问
// 无 rust-ui 转译路径);split/to_int 三轨内建。指纹门控 = V 记录
// ver+win_w+win_h vs 前端存量(020 F1 语义,判变材料移入响应)。滚动
// 动态面 apply_resize/get_lines 副作用端点独立保留(≤3 次/拍)。
//
// 几何常量:tabH = Tab 条行高(逻辑 px;实机标定,resize 免疫——
// 逻辑 px 不随 DPI 缩放)。

use back.api

widget App {
    msg { Init, Tick, KeyIn(str), Menu, TabActivate(int), TabClose(int), NewTab, NewTabProfile(int), ProfileMenu, Split(int), Zoom, CloseFocusPane, SchemeToggle, Shortcut(int), Press(int), Drag(float, float), Drop }

    model {
        var cols int = 100
        var rows int = 30
        // Tab 条数据(tick 刷新;活动 Tab 标签带 "● " 前缀)
        var tab_ids List<int> = []
        var tab_labels List<str> = []
        // scheme(0=classic-dark 1=light;按钮/快捷键循环)
        var scheme int = 0
        // ── 矩形投影槽面(PLAN-020;tick 从 rect-* getters 刷新)──
        // 窗口 client 逻辑 px 与内容区高(Tab 条高恒定扣除)
        var clientW int = 802
        var clientH int = 450
        var tabH int = 40
        // PLAN-024:底部状态栏高(窗框圆角承载层——pane 全方角,左右下
        // 圆角由状态栏 rounded-b-2xl 承担,分屏拓扑无关;编辑器同款)
        var statusH int = 24
        // pane 槽 1..6:存在/键/px 矩形/网格/行快照/光标
        var slot1 int = 0
        var slot2 int = 0
        var slot3 int = 0
        var slot4 int = 0
        var slot5 int = 0
        var slot6 int = 0
        var key1 str = "pane-1"
        var key2 str = ""
        var key3 str = ""
        var key4 str = ""
        var key5 str = ""
        var key6 str = ""
        var x1 int = 0
        var x2 int = 0
        var x3 int = 0
        var x4 int = 0
        var x5 int = 0
        var x6 int = 0
        var y1 int = 0
        var y2 int = 0
        var y3 int = 0
        var y4 int = 0
        var y5 int = 0
        var y6 int = 0
        var w1 int = 802
        var w2 int = 0
        var w3 int = 0
        var w4 int = 0
        var w5 int = 0
        var w6 int = 0
        var h1 int = 450
        var h2 int = 0
        var h3 int = 0
        var h4 int = 0
        var h5 int = 0
        var h6 int = 0
        var lines1 List<str> = []
        var lines2 List<str> = []
        var lines3 List<str> = []
        var lines4 List<str> = []
        var lines5 List<str> = []
        var lines6 List<str> = []
        var g1c int = 100
        var g1r int = 30
        var g2c int = 100
        var g2r int = 30
        var g3c int = 100
        var g3r int = 30
        var g4c int = 100
        var g4r int = 30
        var g5c int = 100
        var g5r int = 30
        var g6c int = 100
        var g6r int = 30
        var cr1 int = 0
        var cc1 int = 0
        var cr2 int = 0
        var cc2 int = 0
        var cr3 int = 0
        var cc3 int = 0
        var cr4 int = 0
        var cc4 int = 0
        var cr5 int = 0
        var cc5 int = 0
        var cr6 int = 0
        var cc6 int = 0
        // divider 槽 1..5(对应 back 槽 7..11):分支/轴/px 矩形
        var dv1 int = 0
        var dv2 int = 0
        var dv3 int = 0
        var dv4 int = 0
        var dv5 int = 0
        var dA1 int = 0
        var dA2 int = 0
        var dA3 int = 0
        var dA4 int = 0
        var dA5 int = 0
        var dX1 int = 0
        var dX2 int = 0
        var dX3 int = 0
        var dX4 int = 0
        var dX5 int = 0
        var dY1 int = 0
        var dY2 int = 0
        var dY3 int = 0
        var dY4 int = 0
        var dY5 int = 0
        var dW1 int = 0
        var dW2 int = 0
        var dW3 int = 0
        var dW4 int = 0
        var dW5 int = 0
        var dH1 int = 0
        var dH2 int = 0
        var dH3 int = 0
        var dH4 int = 0
        var dH5 int = 0
        // 拖拽态(Press 记分支,Drop 清)。dragW/H = 捕获层几何(常驻渲染,
        // 空闲 0x0 不挡点击;拖拽=全幅)——消除"按压后下一帧才出现捕获层"
        // 的帧差竞速(PLAN-022 T-05 实测:快速拖拽丢移动+丢 Drop,
        // dragging 卡死 1 → 全屏捕获层吃掉一切输入)。
        var dragging int = 0
        var dragBranch int = 0
        var dragW int = 0
        var dragH int = 0
        // 投影版本门(F1):变化才拉完整 rect-*,稳态请求数回落 019 水位
        var lastVer int = 0 - 1
        // ── PLAN-025 T-08:profile 菜单面(Init 一次装载;右键 + 开)──
        var profile_names List<str> = []
        var profile_menu int = 0
    }

    timer {
        // PLAN-025 修正:50ms 节拍(分离轨 api.*=HTTP,16ms 同步往返
        // 占死 VM 前端 UI 线程=无响应+内存爬升,用户实录);快滚覆盖
        // 由预取 N=24 承担(模型:50ms 泵 lead ≤15 行 < 24,零空白)。
        Tick (every_ms: 50)
    }

    on {
        .Init -> {
            api.term_apply_resize()
            api.get_lines()
            // PLAN-026 T-03 rev5:双端点聚合(nums 数值面 + snapshot 字符串
            // 面;修前 38 次调用)。索引协议见 db.at mux_tick_nums/snapshot
            // 注释;handler 原语纪律 = [i]/.len()/.push/算术/比较(split/
            // to_int/get 无 a2r handler 转译路径,tmp-probe 实证)。
            var ns List<int> = api.mux_tick_nums()
            var ss List<str> = api.mux_tick_snapshot()
            var one int = 1
            .clientW = ns[1]
            .clientH = ns[2]
            var ch int = ns[2] - .tabH - .statusH
            .lastVer = ns[0]
            .cols = ns[3]
            .rows = ns[4]
            // tab 面(label 预拼)
            var ntabs int = ns[5]
            var labels List<str> = []
            var i int = 0
            loop {
                if i >= ntabs {
                    break
                }
                var lw str = ss[1 + i] + ""
                labels.push(lw)
                i = i + one
            }
            .tab_labels = labels
            // rects 全量应用(nums 槽 k 基址 = 8+(k-1)*9;key = ss
            // [1+ntabs+k-1];px 换算 ‰→px 与旧逐槽 getter 等价)
            var kbase int = 1 + ntabs
            // rects 全量应用(直接索引;槽 k 基址 = 8+(k-1)*9;key = ss)
            .slot1 = ns[9]
            .key1 = ss[kbase + 0] + ""
            .x1 = ns[13] * ns[1] / 1000
            .y1 = ns[14] * ch / 1000
            .w1 = ns[15] * ns[1] / 1000
            .h1 = ns[16] * ch / 1000
            .slot2 = ns[18]
            .key2 = ss[kbase + 1] + ""
            .x2 = ns[22] * ns[1] / 1000
            .y2 = ns[23] * ch / 1000
            .w2 = ns[24] * ns[1] / 1000
            .h2 = ns[25] * ch / 1000
            .slot3 = ns[27]
            .key3 = ss[kbase + 2] + ""
            .x3 = ns[31] * ns[1] / 1000
            .y3 = ns[32] * ch / 1000
            .w3 = ns[33] * ns[1] / 1000
            .h3 = ns[34] * ch / 1000
            .slot4 = ns[36]
            .key4 = ss[kbase + 3] + ""
            .x4 = ns[40] * ns[1] / 1000
            .y4 = ns[41] * ch / 1000
            .w4 = ns[42] * ns[1] / 1000
            .h4 = ns[43] * ch / 1000
            .slot5 = ns[45]
            .key5 = ss[kbase + 4] + ""
            .x5 = ns[49] * ns[1] / 1000
            .y5 = ns[50] * ch / 1000
            .w5 = ns[51] * ns[1] / 1000
            .h5 = ns[52] * ch / 1000
            .slot6 = ns[54]
            .key6 = ss[kbase + 5] + ""
            .x6 = ns[58] * ns[1] / 1000
            .y6 = ns[59] * ch / 1000
            .w6 = ns[60] * ns[1] / 1000
            .h6 = ns[61] * ch / 1000
            .dv1 = ns[65]
            .dA1 = ns[66]
            .dX1 = ns[67] * ns[1] / 1000
            .dY1 = ns[68] * ch / 1000
            .dW1 = ns[69] * ns[1] / 1000
            .dH1 = ns[70] * ch / 1000
            .dv2 = ns[74]
            .dA2 = ns[75]
            .dX2 = ns[76] * ns[1] / 1000
            .dY2 = ns[77] * ch / 1000
            .dW2 = ns[78] * ns[1] / 1000
            .dH2 = ns[79] * ch / 1000
            .dv3 = ns[83]
            .dA3 = ns[84]
            .dX3 = ns[85] * ns[1] / 1000
            .dY3 = ns[86] * ch / 1000
            .dW3 = ns[87] * ns[1] / 1000
            .dH3 = ns[88] * ch / 1000
            .dv4 = ns[92]
            .dA4 = ns[93]
            .dX4 = ns[94] * ns[1] / 1000
            .dY4 = ns[95] * ch / 1000
            .dW4 = ns[96] * ns[1] / 1000
            .dH4 = ns[97] * ch / 1000
            .dv5 = ns[101]
            .dA5 = ns[102]
            .dX5 = ns[103] * ns[1] / 1000
            .dY5 = ns[104] * ch / 1000
            .dW5 = ns[105] * ns[1] / 1000
            .dH5 = ns[106] * ch / 1000
            var npanes int = ns[7]
            var pbase int = 107
            var lcur int = kbase + 11
            i = 0
            loop {
                if i >= npanes {
                    break
                }
                var pb int = pbase + i * 7
                var nl int = ns[pb + 6]
                if ns[pb] == 1 {
                    var acc1 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq1 str = ss[lcur + q] + ""
                        acc1.push(wq1)
                        q = q + one
                    }
                    .lines1 = acc1
                    .g1c = ns[pb + 2]
                    .g1r = ns[pb + 3]
                    .cr1 = ns[pb + 4]
                    .cc1 = ns[pb + 5]
                }
                if ns[pb] == 2 {
                    var acc2 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq2 str = ss[lcur + q] + ""
                        acc2.push(wq2)
                        q = q + one
                    }
                    .lines2 = acc2
                    .g2c = ns[pb + 2]
                    .g2r = ns[pb + 3]
                    .cr2 = ns[pb + 4]
                    .cc2 = ns[pb + 5]
                }
                if ns[pb] == 3 {
                    var acc3 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq3 str = ss[lcur + q] + ""
                        acc3.push(wq3)
                        q = q + one
                    }
                    .lines3 = acc3
                    .g3c = ns[pb + 2]
                    .g3r = ns[pb + 3]
                    .cr3 = ns[pb + 4]
                    .cc3 = ns[pb + 5]
                }
                if ns[pb] == 4 {
                    var acc4 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq4 str = ss[lcur + q] + ""
                        acc4.push(wq4)
                        q = q + one
                    }
                    .lines4 = acc4
                    .g4c = ns[pb + 2]
                    .g4r = ns[pb + 3]
                    .cr4 = ns[pb + 4]
                    .cc4 = ns[pb + 5]
                }
                if ns[pb] == 5 {
                    var acc5 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq5 str = ss[lcur + q] + ""
                        acc5.push(wq5)
                        q = q + one
                    }
                    .lines5 = acc5
                    .g5c = ns[pb + 2]
                    .g5r = ns[pb + 3]
                    .cr5 = ns[pb + 4]
                    .cc5 = ns[pb + 5]
                }
                if ns[pb] == 6 {
                    var acc6 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq6 str = ss[lcur + q] + ""
                        acc6.push(wq6)
                        q = q + one
                    }
                    .lines6 = acc6
                    .g6c = ns[pb + 2]
                    .g6r = ns[pb + 3]
                    .cr6 = ns[pb + 4]
                    .cc6 = ns[pb + 5]
                }
                lcur = lcur + nl
                i = i + one
            }
            // PLAN-025 T-08:profile 名单一次装载(空配置 = 空菜单,
            // 右键 + 仍可用——default 建_TAB回落缺省 shell)。
            .profile_names = api.term_profile_names()
        }

        .Tick -> {
            api.term_apply_resize()
            api.get_lines()
            // PLAN-026 T-03 rev5:双端点聚合(修前稳态 22 次/拍,全量臂
            // +68)。指纹门控(020 F1 语义)= nums ver/win_w/win_h vs 前端
            // 存量,判变材料在响应内——探测请求消灭。
            var ns List<int> = api.mux_tick_nums()
            var geomChanged int = 0
            if ns[0] != .lastVer {
                geomChanged = 1
            }
            if ns[1] != .clientW {
                geomChanged = 1
            }
            if ns[2] != .clientH {
                geomChanged = 1
            }
            // 行快照/光标每拍(活输出)——字符串面每拍拉
            var ss List<str> = api.mux_tick_snapshot()
            var one int = 1
            var ntabs int = ns[5]
            var labels List<str> = []
            var i int = 0
            loop {
                if i >= ntabs {
                    break
                }
                var lw str = ss[1 + i] + ""
                labels.push(lw)
                i = i + one
            }
            .tab_labels = labels
            var kbase int = 1 + ntabs
            if geomChanged == 1 {
                .clientW = ns[1]
                .clientH = ns[2]
                var ch int = ns[2] - .tabH - .statusH
                .lastVer = ns[0]
                .cols = ns[3]
                .rows = ns[4]
                // rects 直接索引(同 Init;ch 已在本块派生)
                .slot1 = ns[9]
                .key1 = ss[kbase + 0] + ""
                .x1 = ns[13] * ns[1] / 1000
                .y1 = ns[14] * ch / 1000
                .w1 = ns[15] * ns[1] / 1000
                .h1 = ns[16] * ch / 1000
                .slot2 = ns[18]
                .key2 = ss[kbase + 1] + ""
                .x2 = ns[22] * ns[1] / 1000
                .y2 = ns[23] * ch / 1000
                .w2 = ns[24] * ns[1] / 1000
                .h2 = ns[25] * ch / 1000
                .slot3 = ns[27]
                .key3 = ss[kbase + 2] + ""
                .x3 = ns[31] * ns[1] / 1000
                .y3 = ns[32] * ch / 1000
                .w3 = ns[33] * ns[1] / 1000
                .h3 = ns[34] * ch / 1000
                .slot4 = ns[36]
                .key4 = ss[kbase + 3] + ""
                .x4 = ns[40] * ns[1] / 1000
                .y4 = ns[41] * ch / 1000
                .w4 = ns[42] * ns[1] / 1000
                .h4 = ns[43] * ch / 1000
                .slot5 = ns[45]
                .key5 = ss[kbase + 4] + ""
                .x5 = ns[49] * ns[1] / 1000
                .y5 = ns[50] * ch / 1000
                .w5 = ns[51] * ns[1] / 1000
                .h5 = ns[52] * ch / 1000
                .slot6 = ns[54]
                .key6 = ss[kbase + 5] + ""
                .x6 = ns[58] * ns[1] / 1000
                .y6 = ns[59] * ch / 1000
                .w6 = ns[60] * ns[1] / 1000
                .h6 = ns[61] * ch / 1000
                .dv1 = ns[65]
                .dA1 = ns[66]
                .dX1 = ns[67] * ns[1] / 1000
                .dY1 = ns[68] * ch / 1000
                .dW1 = ns[69] * ns[1] / 1000
                .dH1 = ns[70] * ch / 1000
                .dv2 = ns[74]
                .dA2 = ns[75]
                .dX2 = ns[76] * ns[1] / 1000
                .dY2 = ns[77] * ch / 1000
                .dW2 = ns[78] * ns[1] / 1000
                .dH2 = ns[79] * ch / 1000
                .dv3 = ns[83]
                .dA3 = ns[84]
                .dX3 = ns[85] * ns[1] / 1000
                .dY3 = ns[86] * ch / 1000
                .dW3 = ns[87] * ns[1] / 1000
                .dH3 = ns[88] * ch / 1000
                .dv4 = ns[92]
                .dA4 = ns[93]
                .dX4 = ns[94] * ns[1] / 1000
                .dY4 = ns[95] * ch / 1000
                .dW4 = ns[96] * ns[1] / 1000
                .dH4 = ns[97] * ch / 1000
                .dv5 = ns[101]
                .dA5 = ns[102]
                .dX5 = ns[103] * ns[1] / 1000
                .dY5 = ns[104] * ch / 1000
                .dW5 = ns[105] * ns[1] / 1000
                .dH5 = ns[106] * ch / 1000
            }
            // ── 行快照/光标/网格每拍(pane 段与行段镜像游标)──
            var npanes int = ns[7]
            var pbase int = 107
            var lcur int = kbase + 11
            i = 0
            loop {
                if i >= npanes {
                    break
                }
                var pb int = pbase + i * 7
                var nl int = ns[pb + 6]
                if ns[pb] == 1 {
                    var acc1 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq1 str = ss[lcur + q] + ""
                        acc1.push(wq1)
                        q = q + one
                    }
                    .lines1 = acc1
                    .g1c = ns[pb + 2]
                    .g1r = ns[pb + 3]
                    .cr1 = ns[pb + 4]
                    .cc1 = ns[pb + 5]
                }
                if ns[pb] == 2 {
                    var acc2 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq2 str = ss[lcur + q] + ""
                        acc2.push(wq2)
                        q = q + one
                    }
                    .lines2 = acc2
                    .g2c = ns[pb + 2]
                    .g2r = ns[pb + 3]
                    .cr2 = ns[pb + 4]
                    .cc2 = ns[pb + 5]
                }
                if ns[pb] == 3 {
                    var acc3 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq3 str = ss[lcur + q] + ""
                        acc3.push(wq3)
                        q = q + one
                    }
                    .lines3 = acc3
                    .g3c = ns[pb + 2]
                    .g3r = ns[pb + 3]
                    .cr3 = ns[pb + 4]
                    .cc3 = ns[pb + 5]
                }
                if ns[pb] == 4 {
                    var acc4 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq4 str = ss[lcur + q] + ""
                        acc4.push(wq4)
                        q = q + one
                    }
                    .lines4 = acc4
                    .g4c = ns[pb + 2]
                    .g4r = ns[pb + 3]
                    .cr4 = ns[pb + 4]
                    .cc4 = ns[pb + 5]
                }
                if ns[pb] == 5 {
                    var acc5 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq5 str = ss[lcur + q] + ""
                        acc5.push(wq5)
                        q = q + one
                    }
                    .lines5 = acc5
                    .g5c = ns[pb + 2]
                    .g5r = ns[pb + 3]
                    .cr5 = ns[pb + 4]
                    .cc5 = ns[pb + 5]
                }
                if ns[pb] == 6 {
                    var acc6 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq6 str = ss[lcur + q] + ""
                        acc6.push(wq6)
                        q = q + one
                    }
                    .lines6 = acc6
                    .g6c = ns[pb + 2]
                    .g6r = ns[pb + 3]
                    .cr6 = ns[pb + 4]
                    .cc6 = ns[pb + 5]
                }
                lcur = lcur + nl
                i = i + one
            }
        }

        .KeyIn(k) -> {
            // PLAN-026 needs_fix: 载荷直写(split 形态键入队列在前端进程、
            // 泵在 back 永不相交——$event 侧车把 VT 串随消息跨进程,
            // send_keys 裸写焦点 Pane;merged 同路径直调。快照刷新面
            // 不变(rev5 双端点)。
            api.term_send_keys(k)
            var ns List<int> = api.mux_tick_nums()
            var ss List<str> = api.mux_tick_snapshot()
            var one int = 1
            var ntabs int = ns[5]
            var npanes int = ns[7]
            var pbase int = 107
            var lcur int = 1 + ntabs + 11
            var i int = 0
            loop {
                if i >= npanes {
                    break
                }
                var pb int = pbase + i * 7
                var nl int = ns[pb + 6]
                if ns[pb] == 1 {
                    var acc1 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq1 str = ss[lcur + q] + ""
                        acc1.push(wq1)
                        q = q + one
                    }
                    .lines1 = acc1
                    .cr1 = ns[pb + 4]
                    .cc1 = ns[pb + 5]
                }
                if ns[pb] == 2 {
                    var acc2 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq2 str = ss[lcur + q] + ""
                        acc2.push(wq2)
                        q = q + one
                    }
                    .lines2 = acc2
                    .cr2 = ns[pb + 4]
                    .cc2 = ns[pb + 5]
                }
                if ns[pb] == 3 {
                    var acc3 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq3 str = ss[lcur + q] + ""
                        acc3.push(wq3)
                        q = q + one
                    }
                    .lines3 = acc3
                    .cr3 = ns[pb + 4]
                    .cc3 = ns[pb + 5]
                }
                if ns[pb] == 4 {
                    var acc4 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq4 str = ss[lcur + q] + ""
                        acc4.push(wq4)
                        q = q + one
                    }
                    .lines4 = acc4
                    .cr4 = ns[pb + 4]
                    .cc4 = ns[pb + 5]
                }
                if ns[pb] == 5 {
                    var acc5 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq5 str = ss[lcur + q] + ""
                        acc5.push(wq5)
                        q = q + one
                    }
                    .lines5 = acc5
                    .cr5 = ns[pb + 4]
                    .cc5 = ns[pb + 5]
                }
                if ns[pb] == 6 {
                    var acc6 List<str> = []
                    var q int = 0
                    loop {
                        if q >= nl {
                            break
                        }
                        var wq6 str = ss[lcur + q] + ""
                        acc6.push(wq6)
                        q = q + one
                    }
                    .lines6 = acc6
                    .cr6 = ns[pb + 4]
                    .cc6 = ns[pb + 5]
                }
                lcur = lcur + nl
                i = i + one
            }
        }

        // PLAN-015:右键菜单 Interrupt 项(载荷 3)→ term_interrupt()。
        .Menu -> {
            var item int = api.term_menu_take()
            if item == 3 {
                api.term_interrupt()
            }
        }
        .TabActivate(i) -> {
            var tid int = api.mux_tab_id_at(i)
            api.mux_enqueue(5, tid)
        }
        .TabClose(i) -> {
            var tid int = api.mux_tab_id_at(i)
            api.mux_enqueue(6, tid)
        }
        .NewTab -> {
            api.mux_enqueue(1, 0)
        }
        // PLAN-025 T-08:profile 菜单选型建_TAB(槽位 1 起编码入队;
        // 建后收菜单)。
        .NewTabProfile(i) -> {
            api.mux_enqueue(1, i + 1)
            .profile_menu = 0
        }
        // 右键 + 开/收 profile 菜单(与 Tab 条右键关闭同形态)。
        .ProfileMenu -> {
            if .profile_menu == 1 {
                .profile_menu = 0
            } else {
                .profile_menu = 1
            }
        }
        // 分屏(ax 0=纵向堆叠 col 1=横向并排 row;深度不限,MAX_PANES 帽)。
        // 注:参数名不可叫 axis——与模型字段同名时 a2r 处理器体把它
        // 译成 self.axis(载荷被遮蔽,实测点按钮分出 axis=-1 的屏)。
        .Split(ax) -> {
            api.mux_enqueue(2, ax)
        }
        .Zoom -> {
            var fid int = api.mux_focus_id()
            api.mux_enqueue(4, fid)
        }
        // 手动测试面:关焦点 Pane(=Ctrl+Shift+W 等价;关末 Pane 转关 Tab)
        .CloseFocusPane -> {
            var fid int = api.mux_focus_id()
            api.mux_enqueue(3, fid)
        }
        .SchemeToggle -> {
            if .scheme == 1 {
                .scheme = 0
            } else {
                .scheme = 1
            }
        }
        // WT 风格快捷键分派(§5 D5 表;019 窗口全局语义):
        // 1 新Tab / 2 关Pane / 3 横分 / 4 纵分 / 5 zoom /
        // 6·7 前 Tab(C-S-Tab、C-S-←)/ 8 后 Tab(C-S-→)/ 9 scheme。
        .Shortcut(n) -> {
            if n == 1 {
                api.mux_enqueue(1, 0)
            }
            if n == 2 {
                var fid int = api.mux_focus_id()
                api.mux_enqueue(3, fid)
            }
            if n == 3 {
                api.mux_enqueue(2, 1)
            }
            if n == 4 {
                api.mux_enqueue(2, 0)
            }
            if n == 5 {
                var fid int = api.mux_focus_id()
                api.mux_enqueue(4, fid)
            }
            if n == 6 {
                var cnt int = api.mux_tab_count()
                var cur int = 0
                var i int = 0
                loop {
                    if i >= cnt {
                        break
                    }
                    if api.mux_tab_is_active_at(i) == 1 {
                        cur = i
                    }
                    i = i + 1
                }
                var prv int = cur - 1
                if prv < 0 {
                    prv = cnt - 1
                }
                var ptid int = api.mux_tab_id_at(prv)
                api.mux_enqueue(5, ptid)
            }
            if n == 7 {
                var cnt2 int = api.mux_tab_count()
                var cur2 int = 0
                var i2 int = 0
                loop {
                    if i2 >= cnt2 {
                        break
                    }
                    if api.mux_tab_is_active_at(i2) == 1 {
                        cur2 = i2
                    }
                    i2 = i2 + 1
                }
                var prv2 int = cur2 - 1
                if prv2 < 0 {
                    prv2 = cnt2 - 1
                }
                var ptid2 int = api.mux_tab_id_at(prv2)
                api.mux_enqueue(5, ptid2)
            }
            if n == 8 {
                var cnt3 int = api.mux_tab_count()
                var cur3 int = 0
                var i3 int = 0
                loop {
                    if i3 >= cnt3 {
                        break
                    }
                    if api.mux_tab_is_active_at(i3) == 1 {
                        cur3 = i3
                    }
                    i3 = i3 + 1
                }
                var nxt int = cur3 + 1
                if nxt >= cnt3 {
                    nxt = 0
                }
                var ntid int = api.mux_tab_id_at(nxt)
                api.mux_enqueue(5, ntid)
            }
            if n == 9 {
                if .scheme == 1 {
                    .scheme = 0
                } else {
                    .scheme = 1
                }
            }
            // 10-13 方向切 pane(Alt+WASD;PLAN-022 T-06 用户指令)。
            if n == 10 {
                api.mux_focus_dir(0)
            }
            if n == 11 {
                api.mux_focus_dir(1)
            }
            if n == 12 {
                api.mux_focus_dir(2)
            }
            if n == 13 {
                api.mux_focus_dir(3)
            }
        }
        // 分隔条交互(PLAN-020 D3/D4):k = back 槽号 7..11;按住查分支
        // 挂捕获层;捕获层 onmousemove(coords "1000x1000")把内容区 ‰
        // 坐标直喂 back mux_resize_branch(轴判/换算/磁吸/钳位全在 back
        // 落定);onmouseup 落定撤层。to_int 为 499 M3 在库先例。
        .Press(k) -> {
            var b int = api.mux_rect_branch(k)
            .dragBranch = b
            .dragging = 1
            .dragW = .clientW
            .dragH = .clientH - .tabH - .statusH
        }
        .Drag(x, y) -> {
            api.mux_resize_branch(.dragBranch, x.to_int(), y.to_int())
        }
        .Drop -> {
            .dragging = 0
            .dragBranch = 0
            .dragW = 0
            .dragH = 0
        }
    }

    view {
        col {
            style: "w-full h-screen bg-background"
            row {
                style: "w-full"
                for i, label in .tab_labels {
                    button (text: label) {
                        onclick: .TabActivate(i)
                        oncontextmenu: .TabClose(i)
                    }
                }
                button (text: "+") {
                    onclick: .NewTab
                    oncontextmenu: .ProfileMenu
                }
                // PLAN-025 T-08:profile 子菜单(右键 + 展开;选中建_TAB,
                // ✕ 收起;空配置不渲染)。
                if .profile_menu == 1 {
                    for j, pname in .profile_names {
                        button (text: pname) {
                            onclick: .NewTabProfile(j)
                        }
                    }
                    button (text: "✕") {
                        onclick: .ProfileMenu
                    }
                }
                button (text: "横分") {
                    onclick: .Split(1)
                }
                button (text: "竖分") {
                    onclick: .Split(0)
                }
                button (text: "关Pane") {
                    onclick: .CloseFocusPane
                }
                button (text: "Zoom") {
                    onclick: .Zoom
                }
                button (text: "◐") {
                    onclick: .SchemeToggle
                }
            }
            // 内容区 = 分隔条/槽位的坐标系原点(overlay 锚)
            div {
                style: "relative w-full flex-1"
                div {
                    style: "w-full h-full bg-background"
                }
                if .slot1 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y1}px] left-[${.x1}px] w-[${.w1}px] h-[${.h1}px]"
                        terminal {
                            key: .key1
                            cols: .g1c
                            rows: .g1r
                            lines: .lines1
                            cursor_row: .cr1
                            cursor_col: .cc1
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.ctrl.shift.t: .Shortcut(1)
                            onkeydown.ctrl.shift.w: .Shortcut(2)
                            onkeydown.ctrl.shift.e: .Shortcut(3)
                            onkeydown.ctrl.shift.o: .Shortcut(4)
                            onkeydown.ctrl.shift.z: .Shortcut(5)
                            onkeydown.ctrl.shift.tab: .Shortcut(6)
                            onkeydown.ctrl.shift.left: .Shortcut(7)
                            onkeydown.ctrl.shift.right: .Shortcut(8)
                            onkeydown.ctrl.shift.k: .Shortcut(9)
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                if .slot2 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y2}px] left-[${.x2}px] w-[${.w2}px] h-[${.h2}px]"
                        terminal {
                            key: .key2
                            cols: .g2c
                            rows: .g2r
                            lines: .lines2
                            cursor_row: .cr2
                            cursor_col: .cc2
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                if .slot3 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y3}px] left-[${.x3}px] w-[${.w3}px] h-[${.h3}px]"
                        terminal {
                            key: .key3
                            cols: .g3c
                            rows: .g3r
                            lines: .lines3
                            cursor_row: .cr3
                            cursor_col: .cc3
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                if .slot4 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y4}px] left-[${.x4}px] w-[${.w4}px] h-[${.h4}px]"
                        terminal {
                            key: .key4
                            cols: .g4c
                            rows: .g4r
                            lines: .lines4
                            cursor_row: .cr4
                            cursor_col: .cc4
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                if .slot5 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y5}px] left-[${.x5}px] w-[${.w5}px] h-[${.h5}px]"
                        terminal {
                            key: .key5
                            cols: .g5c
                            rows: .g5r
                            lines: .lines5
                            cursor_row: .cr5
                            cursor_col: .cc5
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                if .slot6 == 1 {
                    div {
                        style: f"absolute z-10 top-[${.y6}px] left-[${.x6}px] w-[${.w6}px] h-[${.h6}px]"
                        terminal {
                            key: .key6
                            cols: .g6c
                            rows: .g6r
                            lines: .lines6
                            cursor_row: .cr6
                            cursor_col: .cc6
                            scheme: .scheme
                            oninput: .KeyIn($event)($event)
                            onmenu: .Menu
                            onkeydown.alt.w: .Shortcut(10)
                            onkeydown.alt.s: .Shortcut(11)
                            onkeydown.alt.a: .Shortcut(12)
                            onkeydown.alt.d: .Shortcut(13)
                        }
                    }
                }
                // ── 分隔条薄条(轴 1=竖条 8px 宽;轴 0=横条 8px 高;
                // 定尺寸 div 承载视觉,mouse-area Fill 子件承载命中)──
                if .dv1 != 0 {
                    if .dA1 == 1 {
                        div {
                            style: f"absolute z-20 top-[${.dY1}px] left-[${.dX1}px] w-[8px] h-[${.dH1}px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(7), onmouseup: .Drop) {}
                        }
                    } else {
                        div {
                            style: f"absolute z-20 top-[${.dY1}px] left-[${.dX1}px] w-[${.dW1}px] h-[8px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(7), onmouseup: .Drop) {}
                        }
                    }
                }
                if .dv2 != 0 {
                    if .dA2 == 1 {
                        div {
                            style: f"absolute z-20 top-[${.dY2}px] left-[${.dX2}px] w-[8px] h-[${.dH2}px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(8), onmouseup: .Drop) {}
                        }
                    } else {
                        div {
                            style: f"absolute z-20 top-[${.dY2}px] left-[${.dX2}px] w-[${.dW2}px] h-[8px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(8), onmouseup: .Drop) {}
                        }
                    }
                }
                if .dv3 != 0 {
                    if .dA3 == 1 {
                        div {
                            style: f"absolute z-20 top-[${.dY3}px] left-[${.dX3}px] w-[8px] h-[${.dH3}px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(9), onmouseup: .Drop) {}
                        }
                    } else {
                        div {
                            style: f"absolute z-20 top-[${.dY3}px] left-[${.dX3}px] w-[${.dW3}px] h-[8px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(9), onmouseup: .Drop) {}
                        }
                    }
                }
                if .dv4 != 0 {
                    if .dA4 == 1 {
                        div {
                            style: f"absolute z-20 top-[${.dY4}px] left-[${.dX4}px] w-[8px] h-[${.dH4}px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(10), onmouseup: .Drop) {}
                        }
                    } else {
                        div {
                            style: f"absolute z-20 top-[${.dY4}px] left-[${.dX4}px] w-[${.dW4}px] h-[8px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(10), onmouseup: .Drop) {}
                        }
                    }
                }
                if .dv5 != 0 {
                    if .dA5 == 1 {
                        div {
                            style: f"absolute z-20 top-[${.dY5}px] left-[${.dX5}px] w-[8px] h-[${.dH5}px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(11), onmouseup: .Drop) {}
                        }
                    } else {
                        div {
                            style: f"absolute z-20 top-[${.dY5}px] left-[${.dX5}px] w-[${.dW5}px] h-[8px] bg-[#8899aa]"
                            mouse-area (style: "w-full h-full", onmousedown: .Press(11), onmouseup: .Drop) {}
                        }
                    }
                }
                mouse-area (coords: "1000x1000", style: f"absolute z-30 top-0 left-0 w-[${.dragW}px] h-[${.dragH}px]", onmousemove: .Drag, onmouseup: .Drop) {}
            }
            // ── 底部状态栏(PLAN-024):窗框圆角承载层——pane 槽全方角,
            // 左右下圆角由本栏 rounded-b-2xl 承担(与虚拟窗框 WIN_RADIUS
            // 同径),分屏拓扑无关;编辑器状态栏同款。内容 = 焦点 pane
            // 计数 + 引擎网格几何。
            row {
                style: "w-full h-[24px] rounded-b-[15px] bg-[#e9e4d8] px-3 items-center justify-between"
                text "◉ AutoTerm mux" { style: "text-xs" }
                text f"${.cols}×${.rows}" { style: "text-xs" }
            }
        }
    }
}
