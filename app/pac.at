// pac.at — AutoTerm 统一工程入口清单（PLAN-017：at-app 三形态工程置换
// app/ 桌面壳后的并合面；注册键承 013 T7 旧壳，三形态键承 at-app）。
//
// 定位：AutoOS 虚拟桌面通用终端唯一工程入口——一份 .at 源三形态
// （auto run -r rust|vm|vue）+ 桌面 launcher 装载（apps.manifest 臂
// repo ../auto-term/app）。引擎 = autoterm-core（autoterm_core.dll，
// libloading 运行期加载）：VM/desktop 形态经 auto.term shims 进程内绑定，
// rust 形态经 term.rs 侧车 crate::term，vue 形态经 axum back 委托——
// 同一 DLL 三面。dll 缺席优雅降级（spawn 返 0，宿主不崩）。
//
// 部署件契约（003 §5；auto-os-config scripts/deploy-autoterm.sh 组布局
// 感知，幂等）：autoterm_core.dll + autoterm-ctrlc.exe → 宿主 exe 同目录；
// term 门面 → stdlib 安装副本。auto-term 侧先 `cargo build -p autoterm-core`。
//
// 无独立 back daemon：VM/desktop 形态引擎在宿主进程内（src/back 为本地
// 委托体契约，非 HTTP 服务）；vue 形态 split 起临时 axum。render vm——
// terminal 为 VM 原生组件（vue 轨只读视口为设计边界，非缺陷）。

name: "auto-term"
version: "0.1.0"
description: "AutoTerm — AutoOS 虚拟桌面通用终端"

scene: "ui"
render: "vm"
title: "AutoTerm"
title_zh: "终端"
icon: "terminal"
category: "system"
api: "rust"
// auto-os/PLAN-061 T-03：原显式 `theme: "dark"` 标量键退役 = **follow 宿主**
// （宿主策略完整快照 > 本 design 默认 > legacy 回退；显式值会以 pac 优先级
// 压过宿主跟随，两族×明暗需求下不声明）。原 dark 默认改由 app.at design
// 派生腿承接（dark_mode 位默认 true，保现暗色默认；◐ scheme 业务开关翻
// dark_mode 位，终端 classic-dark/light 调色语义不变）。PTY/VT ANSI 调色
// = terminal 原生组件内容域豁免不映射。主合同反链见 README。
// `vendor/themes` 为 UI 管理渠道发布的**固定版本快照**（themes 0.2.0，内容
// digest 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
// per-file sha256 与源包逐文件校验同律；不可二次编辑、非第二权威源）。
dep themes {
    path: "vendor/themes"
}
// 014:rust 轨生成应用的可执行产物名(缺省 = 包名 auto_term)。
exe_name: "auto-term"
// 014:整窗即终端——window 给开窗初值(≈100×30 格);之后由几何随动
// 收敛(可用空间反推网格 → 引擎 resize → View 几何回流),最大化/拖拽
// 都跟随,不受此初值约束。
window: "802x482"
# 端口 = auto-os 伞形 17xxx 带预留（apps.manifest 同步登记 17400/17401）；
# 本 app 无 back daemon，键为伞形登记一致性占位。
front_port: 17400
back_port: 17401

// PLAN-013 T2: .rs 侧车——crate::term(引擎胶水,源自 at-gen/src/engine.rs)
// 供给 rust/vue 两个生成点;VM/desktop 形态经 auto.term shims 走同一 DLL,
// 无需侧车。
rust_sidecar {
    modules: ["term:term.rs"]
    // PLAN-025:autoterm-config 经 path 注入(sidecar 注入器 path: 形态;
    // rel 相对生成 crate 目录 = app/rust-workspace/<member>)。
    deps: ["libloading:0.8", "autoterm-config:path:../../../crates/autoterm-config"]
}
