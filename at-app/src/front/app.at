// at-app src/front/app.at — AutoTerm 标准 AutoUI 前端(PLAN-013 T5;
// 014 直键入收口:整窗只渲染 terminal 本体,不再有输入行/按钮)
//
// terminal 组件(props-feed 形态甲)+ oninput 直键入;三形态同一源:
//   auto run -r rust → a2r iced(View::Terminal 臂,T3)
//   auto run -r vm   → AutoVM 动态轨(convert_terminal,OS-013 两臂)
//   auto run -r vue  → Vite 页面(<pre> 最小视口臂,T4,只读)+ axum back
//
// 输入语义(像 Windows Terminal):点击终端获得焦点后直接键入;widget 把
// 按键翻译成 VT 串入 TerminalCore 队列,消息 .KeyIn 只当触发器——
// term_pump_input() 排空队列裸写引擎(无 \r\n 补缀),随后 get_lines()
// 收割回显。timer 驱动 50ms 轮询,命令输出(含长跑任务)流式上屏,
// 不再依赖按钮 tick。
//
// 014 积压报警:展示面(置顶横幅)已按用户裁定撤下;采样/计数仍在
// back 契约面(api.at term_backlog_*)保留,供诊断消费。

use back.api: get_lines, term_pump_input, term_apply_resize, term_cols, term_rows, term_cursor_row, term_cursor_col

widget App {
    msg { Init, Tick, KeyIn }

    model {
        var lines List<str> = []
        var cols int = 100
        var rows int = 30
        var crow int = 0
        var ccol int = 0
    }

    timer {
        Tick (every_ms: 50)
    }

    on {
        .Init -> {
            .lines = get_lines()
            .crow = term_cursor_row()
            .ccol = term_cursor_col()
        }
        .Tick -> {
            term_apply_resize()
            .cols = term_cols()
            .rows = term_rows()
            .lines = get_lines()
            .crow = term_cursor_row()
            .ccol = term_cursor_col()
        }
        .KeyIn -> {
            term_pump_input()
            .lines = get_lines()
            .crow = term_cursor_row()
            .ccol = term_cursor_col()
        }
    }

    view {
        col {
            style: "w-full h-screen bg-background"
            terminal {
                key: "at-app"
                cols: .cols
                rows: .rows
                lines: .lines
                cursor_row: .crow
                cursor_col: .ccol
                oninput: .KeyIn
            }
        }
    }
}
