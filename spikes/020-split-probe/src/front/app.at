// PLAN-020 决断实验:mouse-area 点击通道判定。
// 左:大色块(300x160);右:细条(10x300)。各点一下,看 hits 计数。
widget App {
    msg { Init, Tick, HitBig, HitStrip }
    model {
        var hitsBig int = 0
        var hitsStrip int = 0
    }
    timer { Tick (every_ms: 200) }
    on {
        .Init -> {}
        .Tick -> {}
        .HitBig -> {
            .hitsBig = .hitsBig + 1
        }
        .HitStrip -> {
            .hitsStrip = .hitsStrip + 1
        }
    }
    view {
        col {
            style: "w-full h-screen bg-background"
            text f"hitsBig=${.hitsBig} hitsStrip=${.hitsStrip}" {
                style: "text-lg text-foreground"
            }
            row {
                style: "w-full h-[320px]"
                mouse-area (style: "w-[300px] h-[300px] bg-[#3366aa]", onmousedown: .HitBig) {}
                mouse-area (style: "w-[10px] h-[300px] bg-[#8899aa]", onmousedown: .HitStrip) {}
            }
        }
    }
}
