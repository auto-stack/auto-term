// PLAN-006 S2 spike: TermSession 子集 round-trip 样本
// 形状基准 = autoterm-core/src/term.rs(手写 Rust 参照):
//   - enum Damage { Full, Lines(Vec<usize>) }
//   - #[derive(Clone, Copy, Debug)] struct GridSize { cols, rows }
//   - struct TermSession + impl 方法 + match Damage
// 目的:a2r 产出 vs 手写风格的构造级 diff,见 NOTES.md。

enum Damage {
    Full
    Lines(List<int>)
}

#[derive(Clone, Copy, Debug)]
type GridSize {
    cols int
    rows int
}

#[derive(Clone, Debug)]
type TermSession {
    size GridSize
    exited bool
    damage Damage
}

ext GridSize {
    fn new(cols int, rows int) GridSize {
        return GridSize(cols: cols, rows: rows)
    }

    fn area() int {
        return self.cols * self.rows
    }
}

ext TermSession {
    pub fn new(cols int, rows int) TermSession {
        return TermSession(size: GridSize(cols: cols, rows: rows), exited: false, damage: Damage.Full)
    }

    pub fn update(dmg Damage) Damage {
        is dmg {
            Damage.Full -> {
                return Damage.Full
            }
            Damage.Lines(lines) -> {
                return Damage.Lines(lines)
            }
        }
        return Damage.Full
    }

    pub fn clear_selection() bool {
        return self.exited
    }
}

fn main() {
    let session = TermSession.new(80, 24)
    let d = session.update(Damage.Full)
    print("area =", GridSize(cols: 80, rows: 24).area())
    print("damage:", d)
}
